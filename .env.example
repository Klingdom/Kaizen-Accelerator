# BAM-X Kaizen OS — environment variable template.
# Copy to .env on the VPS and fill in real values. Never commit .env.

# ─── Web service ────────────────────────────────────────────────────────────
# DOMAIN controls Caddy's auto-HTTPS behavior:
#   localhost           → HTTP only, no TLS (use for local dev)
#   kaizen.example.com  → HTTPS via Let's Encrypt, HTTP→HTTPS redirect
DOMAIN=localhost

# Email used by Caddy to request Let's Encrypt certs. Required in production.
ACME_EMAIL=admin@example.com

# HTTP_PORT is the port Caddy listens on INSIDE the container. Leave at 80.
HTTP_PORT=80

# Host-side port bindings. Only change if your VPS already runs something
# on 80 / 443. Common alternates when sharing a VPS with other projects:
#   HTTP_PORT_HOST=8080  HTTPS_PORT_HOST=8443
# When using alternates, auto-HTTPS via Let's Encrypt requires either a
# host-level reverse proxy (recommended) or ACME DNS-01. See README.
HTTP_PORT_HOST=80
HTTPS_PORT_HOST=443

# ─── Database (uncomment in docker-compose.yml when Sprint 5+ lands) ───────
# POSTGRES_DB=bamx
# POSTGRES_USER=bamx
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ─── Future app service (Next.js, per ARCHITECTURE.md §7.3) ─────────────────
# NODE_ENV=production
# DATABASE_URL=postgres://bamx:change-me@db:5432/bamx
# SESSION_SECRET=change-me-to-a-long-random-string
