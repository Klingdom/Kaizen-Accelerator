# BAM-X Kaizen OS — environment variable template.
# Copy to .env on the VPS and fill in real values. Never commit .env.

# ─── Web service ────────────────────────────────────────────────────────────
# DOMAIN controls Caddy's auto-HTTPS behavior:
#   localhost           → HTTP only, no TLS (use for local dev)
#   kaizen.example.com  → HTTPS via Let's Encrypt, HTTP→HTTPS redirect
DOMAIN=localhost

# Email used by Caddy to request Let's Encrypt certs. Required in production.
ACME_EMAIL=admin@example.com

# HTTP_PORT is the port Caddy listens on INSIDE the container. Leave at 80.
HTTP_PORT=80

# Host-side port bindings. Defaults (8080 / 8443) are multi-project-safe.
# On a dedicated VPS with no other projects on 80 / 443, override to 80 / 443.
#
# IMPORTANT: these values take effect only when they're in a .env file at the
# repo root (docker compose auto-loads .env for variable substitution).
# Setting these in Hostinger's panel "Environment variables" UI does NOT work
# for host-port mapping — panel env vars go into the container, not the shell.
HTTP_PORT_HOST=8090
HTTPS_PORT_HOST=8443

# ─── Database (uncomment in docker-compose.yml when Sprint 5+ lands) ───────
# POSTGRES_DB=bamx
# POSTGRES_USER=bamx
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ─── Future app service (Next.js, per ARCHITECTURE.md §7.3) ─────────────────
# NODE_ENV=production
# DATABASE_URL=postgres://bamx:change-me@db:5432/bamx
# SESSION_SECRET=change-me-to-a-long-random-string
