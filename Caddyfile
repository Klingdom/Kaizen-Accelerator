# BAM-X Kaizen OS — Caddy configuration
# Serves the marketing HTML at the root + the /js/ MVP modules.
# Auto-HTTPS is enabled in production via Caddy's ACME integration.
#
# Two listen modes selected via the DOMAIN environment variable:
#   DOMAIN=localhost   → HTTP on :80 only, no TLS (for local `docker compose up`)
#   DOMAIN=your.tld    → HTTPS on :443 with Let's Encrypt, redirects :80 → :443

{
	# Global options.
	# Admin endpoint disabled in production to reduce attack surface.
	admin off
	# Reasonable defaults for a static site.
	servers {
		trusted_proxies static private_ranges
	}
	# In local mode the email is unused; in production Let's Encrypt needs it.
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN:localhost}:{$HTTP_PORT:80} {
	root * /srv

	# Local dev: no TLS. Production: auto-HTTPS kicks in when DOMAIN != localhost.
	@localdev expression {env.DOMAIN} == "localhost" || {env.DOMAIN} == ""
	handle @localdev {
		# No TLS directive; Caddy will serve HTTP only on this block.
	}

	# Security headers applied to all responses.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Conservative CSP — no external scripts/styles in MVP (zero runtime deps).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		# Remove the Caddy server header.
		-Server
	}

	# MIME: ES modules must be served as application/javascript.
	@js path *.js
	header @js Content-Type application/javascript

	# Health endpoint — matches the Docker HEALTHCHECK probe.
	respond /health 200 {
		body "ok"
		close
	}

	# Do not serve the design docs, tests, config, CI, or git plumbing even
	# if they leak into the image. Defense in depth on top of .dockerignore.
	# Caddy allows only one path_regexp per matcher, so we use path globs
	# (which allow multiple entries and are OR'd together).
	@forbidden {
		path /ARCHITECTURE.md /PRODUCT_BLUEPRINT.md /UX_FLOWS.md /ENGINE_DESIGN.md
		path /DELIVERY_PLAN.md /AI_AGENTS.md /CATALOG_GAPS.md /PROJECT_TYPE_30D_KAIZEN.md
		path /Dockerfile /Caddyfile /docker-compose.yml /.dockerignore
		path /.env /.env.*
		path /.git /.git/*
		path /.github /.github/*
		path /.claude /.claude/*
		path /tests /tests/*
		path /docs /docs/*
		path /process-service /process-service/*
		path /config /config/*
		path /package.json /package-lock.json
	}
	respond @forbidden 404

	# Enable gzip + zstd for text/* responses.
	encode zstd gzip

	# Static file server for everything else. try_files lets index.html act
	# as default for `/` and falls through to 404.html if present.
	file_server {
		index index.html
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		respond @404 "Not found" 404
		@500 expression {http.error.status_code} >= 500
		respond @500 "Server error" 500
	}

	# Minimal access log to stdout; Docker captures it.
	log {
		output stdout
		format console
		level INFO
	}
}
