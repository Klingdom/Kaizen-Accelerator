# BAM-X Kaizen OS — Caddy configuration
# Serves the marketing HTML at the root + the /js/ MVP modules.
# Auto-HTTPS is enabled in production via Caddy's ACME integration.

{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN:localhost}:{$HTTP_PORT:80} {
	root * /srv
	encode zstd gzip

	# Security headers applied to all responses.
	# NOTE: some reverse proxies (NPM, CloudFront, etc.) strip or rewrite
	# certain headers. The per-path MIME handlers below set Content-Type
	# explicitly so ES modules load correctly even through a stripping proxy.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		-Server
	}

	# Health endpoint — matches the Docker HEALTHCHECK probe.
	respond /health 200 {
		body "ok"
		close
	}

	# Block internal files from being served, even if .dockerignore fails.
	@forbidden {
		path /ARCHITECTURE.md /PRODUCT_BLUEPRINT.md /UX_FLOWS.md /ENGINE_DESIGN.md
		path /DELIVERY_PLAN.md /AI_AGENTS.md /CATALOG_GAPS.md /PROJECT_TYPE_30D_KAIZEN.md
		path /ACCELERATOR_STANDARD.md /DMAIC_STANDARD.md /KAIZEN_EVENT_STANDARD.md
		path /ADHOC_PDCA_STANDARD.md /GLOSSARY.md /SCHEDULING_VISION.md
		path /SCHEDULING_UX.md /SCHEDULING_ARCHITECTURE.md /SCHEDULING_DELIVERABLES.md
		path /SCHEDULING_SYSTEM.md
		path /Dockerfile /Caddyfile /docker-compose.yml /.dockerignore
		path /.env /.env.*
		path /.git /.git/*
		path /.github /.github/*
		path /.claude /.claude/*
		path /tests /tests/*
		path /docs /docs/*
		path /process-service /process-service/*
		path /config /config/*
		path /package.json /package-lock.json
	}
	respond @forbidden 404

	# ES modules require Content-Type application/javascript or text/javascript.
	# Some proxies strip Content-Type; explicit handle blocks ensure the header
	# is set on the final response regardless of upstream behavior.
	@js_files path *.js
	handle @js_files {
		header Content-Type "application/javascript; charset=utf-8"
		file_server
	}

	@css_files path *.css
	handle @css_files {
		header Content-Type "text/css; charset=utf-8"
		file_server
	}

	@html_files path *.html /
	handle @html_files {
		header Content-Type "text/html; charset=utf-8"
		file_server {
			index index.html
		}
	}

	# Catch-all static file server for images, fonts, etc.
	handle {
		file_server {
			index index.html
		}
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		respond @404 "Not found" 404
		@500 expression {http.error.status_code} >= 500
		respond @500 "Server error" 500
	}

	log {
		output stdout
		format console
		level INFO
	}
}
